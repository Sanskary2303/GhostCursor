# cp .env.example .env, then replace CHANGE_ME_64_HEX_CHARS (both places) with:
#   python3 -c "import secrets; print(secrets.token_hex(32))"

# Database Configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=ghost_cursor

# Orchestrator Service Configuration
GHOST_ENV=development
GHOST_STORE=postgres
GHOST_PROVIDER=mock
GHOST_CURSOR_API_KEY=CHANGE_ME_64_HEX_CHARS
GHOST_TENANT_KEYS={"CHANGE_ME_64_HEX_CHARS": "shophive_demo"}
GHOST_RATE_LIMIT_PER_MIN=100000

# GCP_PROJECT_ID=your-gcp-project-id
# GCP_LOCATION=global
# GHOST_MODEL=gemini-3.5-flash
# GHOST_SUMMARY_MODEL=gemini-3.5-flash-lite
# GHOST_SKIP_MODEL_CHECK=1  # only if your organisation blocks reading model metadata

# ShopHive Storefront Demo Configuration
GHOST_CURSOR_TENANT_ID=shophive_demo
GHOST_CURSOR_SERVICE_URL=http://api:8080
SHOPHIVE_ALLOWED_ORIGINS=http://localhost:8081,http://127.0.0.1:8081

