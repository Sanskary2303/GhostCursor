# Ghost Cursor Environment Configuration

# Database Configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=ghost_cursor

# Orchestrator Service Configuration
GHOST_ENV=development
GHOST_STORE=postgres
GHOST_PROVIDER=mock
GHOST_CURSOR_API_KEY=test-key-shophive-demo-0123456789abcdef
GHOST_TENANT_KEYS={"test-key-shophive-demo-0123456789abcdef": "shophive_demo"}
GHOST_RATE_LIMIT_PER_MIN=100000

# Optional Vertex AI Configuration (when GHOST_PROVIDER=vertex)
# GCP_PROJECT_ID=your-gcp-project-id
# GCP_LOCATION=us-central1
# GHOST_MODEL=gemini-2.0-flash

# ShopHive Storefront Demo Configuration
GHOST_CURSOR_TENANT_ID=shophive_demo
GHOST_CURSOR_SERVICE_URL=http://api:8080
SHOPHIVE_ALLOWED_ORIGINS=http://localhost:8081,http://127.0.0.1:8081

