{
  "name": "@ghost-cursor/sdk",
  "version": "0.1.0",
  "description": "Ghost Cursor Frontend SDK - Framework-neutral DOM executor, chat widget, AI cursor, and tour overlay",
  "type": "module",
  "main": "dist/ghost-cursor.es.js",
  "module": "dist/ghost-cursor.es.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/ghost-cursor.es.js",
      "types": "./dist/index.d.ts",
      "default": "./dist/ghost-cursor.es.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit",
    "generate:schemas": "node scripts/generate-schemas.js"
  },
  "dependencies": {
    "preact": "^10.19.3"
  },
  "devDependencies": {
    "eslint": "^9.9.0",
    "jsdom": "^29.1.1",
    "ts-json-schema-generator": "^2.9.0",
    "typescript": "^5.5.4",
    "vite": "^5.4.2",
    "vite-plugin-dts": "^4.0.2",
    "vitest": "^2.0.5"
  },
  "keywords": [
    "ghost-cursor",
    "sdk",
    "ai-assistant",
    "dom-automation",
    "chat-widget",
    "shadow-dom"
  ],
  "author": "Ghost Cursor Team",
  "license": "MIT"
}
