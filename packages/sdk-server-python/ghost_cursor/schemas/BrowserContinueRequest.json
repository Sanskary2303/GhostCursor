{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$ref": "#/definitions/BrowserContinueRequest",
  "definitions": {
    "BrowserContinueRequest": {
      "type": "object",
      "properties": {
        "command": {
          "type": "string",
          "const": "continue"
        },
        "protocolVersion": {
          "$ref": "#/definitions/ProtocolVersion"
        },
        "runId": {
          "$ref": "#/definitions/RunId"
        },
        "eventId": {
          "$ref": "#/definitions/EventId"
        },
        "revision": {
          "type": "number"
        },
        "kind": {
          "type": "string",
          "enum": [
            "actions",
            "answer",
            "cancel"
          ]
        },
        "results": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/ToolResult"
          }
        },
        "answer": {
          "type": "string"
        },
        "context": {
          "$ref": "#/definitions/Partial%3CPageContext%3E"
        }
      },
      "required": [
        "command",
        "protocolVersion",
        "runId",
        "eventId",
        "revision",
        "kind"
      ],
      "additionalProperties": false
    },
    "ProtocolVersion": {
      "type": "string",
      "const": "1",
      "description": "Core TypeScript types for Ghost Cursor SDK Matches the canonical protocol v1 specification"
    },
    "RunId": {
      "type": "string"
    },
    "EventId": {
      "type": "string"
    },
    "ToolResult": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "ok": {
          "type": "boolean"
        },
        "output": {},
        "error": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "ok"
      ],
      "additionalProperties": false
    },
    "Partial<PageContext>": {
      "type": "object",
      "properties": {
        "page": {
          "type": "string"
        },
        "values": {
          "$ref": "#/definitions/Record%3Cstring%2C(string%7Cnumber%7Cboolean)%3E"
        },
        "availableTargets": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "Record<string,(string|number|boolean)>": {
      "type": "object",
      "additionalProperties": {
        "type": [
          "string",
          "number",
          "boolean"
        ]
      }
    }
  }
}
