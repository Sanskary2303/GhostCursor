{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$ref": "#/definitions/PublicResponse",
  "definitions": {
    "PublicResponse": {
      "type": "object",
      "properties": {
        "protocolVersion": {
          "$ref": "#/definitions/ProtocolVersion"
        },
        "runId": {
          "$ref": "#/definitions/RunId"
        },
        "revision": {
          "type": "number"
        },
        "status": {
          "$ref": "#/definitions/RunStatus"
        },
        "reply": {
          "type": "string"
        },
        "questions": {
          "anyOf": [
            {
              "type": "array",
              "items": {
                "$ref": "#/definitions/ClarifyQuestion"
              }
            },
            {
              "type": "null"
            }
          ]
        },
        "actions": {
          "anyOf": [
            {
              "type": "array",
              "items": {
                "$ref": "#/definitions/Action"
              }
            },
            {
              "type": "null"
            }
          ]
        },
        "cards": {
          "anyOf": [
            {
              "type": "array",
              "items": {
                "$ref": "#/definitions/InsightCard"
              }
            },
            {
              "type": "null"
            }
          ],
          "maxItems": 3
        }
      },
      "required": [
        "protocolVersion",
        "runId",
        "revision",
        "status",
        "reply"
      ],
      "additionalProperties": false
    },
    "ProtocolVersion": {
      "type": "string",
      "enum": [
        "1",
        "1.1"
      ],
      "description": "Core TypeScript types for Ghost Cursor SDK Matches the canonical protocol v1 specification"
    },
    "RunId": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
    },
    "RunStatus": {
      "type": "string",
      "enum": [
        "awaiting_actions",
        "awaiting_answer",
        "completed",
        "failed",
        "cancelled"
      ]
    },
    "ClarifyQuestion": {
      "type": "object",
      "properties": {
        "question": {
          "type": "string"
        },
        "options": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "question",
        "options"
      ],
      "additionalProperties": false
    },
    "Action": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "type": {
          "$ref": "#/definitions/ActionType"
        },
        "target_id": {
          "type": "string"
        },
        "value": {
          "type": [
            "string",
            "number",
            "boolean"
          ]
        },
        "target_page": {
          "type": "string"
        },
        "explanation": {
          "type": "string"
        },
        "state": {
          "type": "boolean"
        },
        "steps": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/TourStep"
          }
        },
        "question": {
          "type": "string"
        },
        "options": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "option": {
          "type": "string"
        }
      },
      "required": [
        "type"
      ],
      "additionalProperties": false
    },
    "ActionType": {
      "type": "string",
      "enum": [
        "navigate",
        "click",
        "fill_input",
        "select_option",
        "toggle_switch",
        "guided_tour",
        "ask_clarification"
      ]
    },
    "TourStep": {
      "type": "object",
      "properties": {
        "target_id": {
          "type": "string"
        },
        "message": {
          "type": "string"
        },
        "spotlight": {
          "type": "boolean"
        }
      },
      "required": [
        "target_id",
        "message"
      ],
      "additionalProperties": false
    },
    "InsightCard": {
      "anyOf": [
        {
          "$ref": "#/definitions/MetricCard"
        },
        {
          "$ref": "#/definitions/BarsCard"
        }
      ]
    },
    "MetricCard": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "metric"
        },
        "label": {
          "type": "string"
        },
        "value": {
          "type": [
            "string",
            "number"
          ]
        },
        "delta": {
          "type": [
            "string",
            "number"
          ]
        }
      },
      "required": [
        "type",
        "label",
        "value"
      ],
      "additionalProperties": false
    },
    "BarsCard": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "bars"
        },
        "series": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/BarSeriesItem"
          },
          "maxItems": 8
        }
      },
      "required": [
        "type",
        "series"
      ],
      "additionalProperties": false
    },
    "BarSeriesItem": {
      "type": "object",
      "properties": {
        "label": {
          "type": "string"
        },
        "value": {
          "type": "number"
        }
      },
      "required": [
        "label",
        "value"
      ],
      "additionalProperties": false
    }
  }
}
